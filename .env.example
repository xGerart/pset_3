# Copia este archivo a .env y completa los valores. .env está en .gitignore.

# --- Snowflake (misma cuenta y usuario de servicio del PSet 2; par de llaves, sin contraseña) ---
SNOWFLAKE_ACCOUNT=xxxxxxx-yyyyyyy
SNOWFLAKE_USER=PSET2_SVC
SNOWFLAKE_ROLE=PSET2_ROLE
SNOWFLAKE_WAREHOUSE=PSET2_WH
SNOWFLAKE_DATABASE=PSET2
SNOWFLAKE_PRIVATE_KEY_FILE=./secrets/snowflake_rsa_key.p8

# --- MLflow ---
# Contraseña del Postgres que usa MLflow como backend store (cualquier valor aleatorio)
MLFLOW_DB_PASSWORD=cambia-esta-clave
MLFLOW_TRACKING_URI=http://localhost:5050

# --- LLM por prompting (notebook 03). Solo hace falta si no existen las respuestas en docs/llm/ ---
ANTHROPIC_API_KEY=
